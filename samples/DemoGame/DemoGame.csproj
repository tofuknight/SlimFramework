<Project Sdk="Microsoft.NET.Sdk">
  <!--
    dotnet build 使用 Microsoft.NET.Sdk + GodotSharp 包，这样没有编辑器也能编译。
    用 Godot 4.7 打开时，把 Sdk 改成 Godot.NET.Sdk/4.7.2，并删掉 PackageReference GodotSharp
    （SDK 会自己带这份引用，留着会类型重复）。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SlimFramework.DemoGame</RootNamespace>
    <AssemblyName>SlimFramework.DemoGame</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GodotSharp" Version="$(GodotSharpVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SlimFramework.Godot\SlimFramework.Godot.csproj" />
    <ProjectReference Include="..\SlimFramework.Demo\SlimFramework.Demo.csproj" />
  </ItemGroup>
</Project>
